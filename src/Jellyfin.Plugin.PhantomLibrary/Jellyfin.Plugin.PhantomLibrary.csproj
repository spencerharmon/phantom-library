<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PhantomLibrary</RootNamespace>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <Version>0.5.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1056: URLs in plugin config must remain strings so the
         Jellyfin XML serializer round-trips them. CA1724: the Plugin
         class name is mandated by Jellyfin's plugin discovery and
         collides cosmetically with the Jellyfin.Plugin namespace. -->
    <!-- CA1819 (array-typed properties): DTOs and records bound to TMDB JSON
         payloads use arrays as the natural shape; ReadOnly wrappers buy
         nothing here.
         CA1054/CA1055 (Uri vs string): TMDB URLs are persisted and serialised
         as strings end-to-end; converting at the boundary only adds noise.
         CA1062 (null parameter checks on public APIs): plugin-internal
         extensions and records, callers are constrained.
         CA1001 (disposable fields without IDisposable): TmdbClient is a
         singleton-lifetime DI component; its SemaphoreSlim lives for the
         process.
         CA1812 (uninstantiated internal classes): wire DTOs are
         instantiated by System.Text.Json reflection.
         CA2000 (Dispose IHttpClientFactory.CreateClient): documented as
         pooled — disposing the wrapper is allowed but unnecessary; analyzer
         does not recognise the pattern. -->
    <NoWarn>$(NoWarn);CA1056;CA1724;CA1819;CA1054;CA1055;CA1062;CA1001;CA1812;CA2000;CA1031;CA1307;CA1508;CA1711;CA1725;CA1848;CA1849;CA1873;CA2007;CA2016;CA2234;CA1063;CA1816;CA1822;CA1002;CA1051;CA1303;CA2227;CA1003;CA2100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Plugin depends on patched Jellyfin assemblies (the additive
      IChannelItemRefreshManager interface lives in MediaBrowser.Controller).
      We reference the patched source-tree projects directly so the
      types resolve at compile and the produced DLL binds against the
      runtime jellyfin/ build delivered by install.sh.
      install.sh applies scripts/jellyfin-patches/*.patch onto
      jellyfin/ before invoking dotnet build, so this ProjectReference
      always sees the patched MediaBrowser.Controller.
    -->
    <ProjectReference Include="..\..\jellyfin\Jellyfin.Data\Jellyfin.Data.csproj" />
    <ProjectReference Include="..\..\jellyfin\src\Jellyfin.Database\Jellyfin.Database.Implementations\Jellyfin.Database.Implementations.csproj" />
    <ProjectReference Include="..\..\jellyfin\MediaBrowser.Common\MediaBrowser.Common.csproj" />
    <ProjectReference Include="..\..\jellyfin\MediaBrowser.Controller\MediaBrowser.Controller.csproj" />
    <ProjectReference Include="..\..\jellyfin\MediaBrowser.Model\MediaBrowser.Model.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
    <PackageReference Include="NCrontab" Version="3.3.3" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.PhantomLibrary.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\userPrefsPage.html" />
    <EmbeddedResource Include="Configuration\phantomKebab.js" />
    <EmbeddedResource Include="Configuration\phantomBadges.js" />
    <EmbeddedResource Include="Assets\splash.mp4" />
  </ItemGroup>

  <!--
    Generate Assets/splash.mp4 at build time if missing. The generated
    file is checked into git, so CI hosts without ffmpeg still build
    fine — this target only runs on developer machines after a clean
    or when the file is intentionally deleted. See PLAN.md §0b / §M5.
  -->
  <Target Name="GenerateSplashMp4" BeforeTargets="BeforeBuild" Condition="!Exists('Assets/splash.mp4')">
    <Message Importance="high" Text="Phantom Library: Assets/splash.mp4 missing; invoking ffmpeg to generate it." />
    <Exec Command="ffmpeg -y -f lavfi -i color=c=0x0a0e27:s=1280x720:r=30:d=10 -f lavfi -i anullsrc=channel_layout=stereo:sample_rate=48000 -vf &quot;drawtext=text='Phantom Library':fontcolor=0xa78bfa:fontsize=72:x=(w-text_w)/2:y=(h-text_h)/2-60,drawtext=text='materialising…':fontcolor=0x6b7280:fontsize=36:x=(w-text_w)/2:y=(h-text_h)/2+40&quot; -c:v libx264 -pix_fmt yuv420p -profile:v high -level 4.0 -preset slow -crf 22 -g 30 -keyint_min 30 -c:a aac -b:a 64k -shortest -movflags +faststart Assets/splash.mp4" IgnoreExitCode="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="FfmpegExitCode" />
    </Exec>
    <Error Condition="'$(FfmpegExitCode)' != '0' Or !Exists('Assets/splash.mp4')" Text="ffmpeg failed to generate Assets/splash.mp4 (exit $(FfmpegExitCode)). Install ffmpeg or restore the file from git." />
  </Target>

</Project>
