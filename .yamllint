---
# yamllint config for the in-repo Gitea Actions CI config (.gitea/workflows/).
# Run:  yamllint -c .yamllint .gitea/workflows
# Actions workflow YAML uses `on:` truthy idioms and long comment blocks;
# keep those relaxations vs yamllint defaults.
extends: default

rules:
  document-start:
    present: true
  line-length:
    max: 120
    allow-non-breakable-words: true
  # Ansible/Zuul commonly use `on:`/`yes`/`no` style truthy values and long
  # comment blocks; keep those from being noise.
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
