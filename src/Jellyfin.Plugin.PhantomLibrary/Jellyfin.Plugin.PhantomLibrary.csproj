<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PhantomLibrary</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1056: URLs in plugin config must remain strings so the
         Jellyfin XML serializer round-trips them. CA1724: the Plugin
         class name is mandated by Jellyfin's plugin discovery and
         collides cosmetically with the Jellyfin.Plugin namespace. -->
    <!-- CA1819 (array-typed properties): DTOs and records bound to TMDB JSON
         payloads use arrays as the natural shape; ReadOnly wrappers buy
         nothing here.
         CA1054/CA1055 (Uri vs string): TMDB URLs are persisted and serialised
         as strings end-to-end; converting at the boundary only adds noise.
         CA1062 (null parameter checks on public APIs): plugin-internal
         extensions and records, callers are constrained.
         CA1001 (disposable fields without IDisposable): TmdbClient is a
         singleton-lifetime DI component; its SemaphoreSlim lives for the
         process.
         CA1812 (uninstantiated internal classes): wire DTOs are
         instantiated by System.Text.Json reflection.
         CA2000 (Dispose IHttpClientFactory.CreateClient): documented as
         pooled — disposing the wrapper is allowed but unnecessary; analyzer
         does not recognise the pattern. -->
    <NoWarn>$(NoWarn);CA1056;CA1724;CA1819;CA1054;CA1055;CA1062;CA1001;CA1812;CA2000;CA1031;CA1307;CA1508;CA1711;CA1725;CA1848;CA1849;CA1873;CA2007;CA2016;CA2234;CA1063;CA1816;CA1822;CA1002;CA1051;CA1303;CA2227</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.9" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
