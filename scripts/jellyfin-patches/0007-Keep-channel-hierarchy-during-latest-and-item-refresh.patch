+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Jellyfin.LiveTv.Channels;
+using MediaBrowser.Controller.Channels;
+using MediaBrowser.Controller.Configuration;
+using MediaBrowser.Controller.Dto;
+using MediaBrowser.Controller.Entities;
+using MediaBrowser.Controller.Entities.TV;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.Providers;
+using MediaBrowser.Model.IO;
+using Microsoft.Extensions.Caching.Memory;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.LiveTv.Tests.Channels;
+
+/// <summary>
+/// Non-authoritative channel refreshes (the Home "latest" refresh and the
+/// per-item <see cref="IChannelItemRefreshManager"/> refresh) reach existing
+/// items through the channel root. They must keep an item's valid
+/// Season/Series parent and must not prune the ancestors of items they keep.
+/// The live end-to-end proof is the plugin's
+/// scripts/tests/native-episode-web-queue.test.sh rig.
+/// </summary>
+public class ChannelManagerHierarchyTests
+{
+    private static readonly Guid ChannelId = Guid.Parse("40ab6e9a-f516-a84f-46dc-ea7140855d88");
+    private static readonly Guid OtherChannelId = Guid.Parse("11111111-2222-3333-4444-555555555555");
+
+    private static (ChannelManager Mgr, Series Series, Season Season, Episode Episode, Mock<ILibraryManager> Lib) Build()
+    {
+        var lib = new Mock<ILibraryManager>(MockBehavior.Loose);
+        var channel = new Channel { Id = ChannelId, Name = "Shows" };
+        var series = new Series { Id = Guid.NewGuid(), ParentId = ChannelId, ChannelId = ChannelId };
+        var season = new Season { Id = Guid.NewGuid(), ParentId = series.Id, ChannelId = ChannelId };
+        var episode = new Episode { Id = Guid.NewGuid(), ParentId = season.Id, ChannelId = ChannelId };
+        foreach (BaseItem item in new BaseItem[] { channel, series, season, episode })
+        {
+            lib.Setup(m => m.GetItemById(item.Id)).Returns(item);
+        }
+
+        var mgr = new ChannelManager(
+            userManager: Mock.Of<IUserManager>(),
+            dtoService: Mock.Of<IDtoService>(),
+            libraryManager: lib.Object,
+            logger: NullLogger<ChannelManager>.Instance,
+            config: Mock.Of<IServerConfigurationManager>(),
+            fileSystem: Mock.Of<IFileSystem>(),
+            userDataManager: Mock.Of<IUserDataManager>(),
+            providerManager: Mock.Of<IProviderManager>(),
+            memoryCache: Mock.Of<IMemoryCache>(),
+            channels: Array.Empty<IChannel>());
+        return (mgr, series, season, episode, lib);
+    }
+
+    [Fact]
+    public void IsValidChannelParent_SeasonOfSameChannel_IsKept()
+    {
+        var (mgr, _, season, _, _) = Build();
+        Assert.True(mgr.IsValidChannelParent(season.Id, ChannelId));
+    }
+
+    [Fact]
+    public void IsValidChannelParent_ChannelRoot_IsKept()
+    {
+        var (mgr, _, _, _, _) = Build();
+        Assert.True(mgr.IsValidChannelParent(ChannelId, ChannelId));
+    }
+
+    [Fact]
+    public void IsValidChannelParent_EmptyDeletedOrForeignParent_IsRepaired()
+    {
+        var (mgr, _, season, _, lib) = Build();
+        Assert.False(mgr.IsValidChannelParent(Guid.Empty, ChannelId));
+        Assert.False(mgr.IsValidChannelParent(Guid.NewGuid(), ChannelId));
+        Assert.False(mgr.IsValidChannelParent(season.Id, OtherChannelId));
+
+        var nonFolder = new Episode { Id = Guid.NewGuid(), ChannelId = ChannelId };
+        lib.Setup(m => m.GetItemById(nonFolder.Id)).Returns(nonFolder);
+        Assert.False(mgr.IsValidChannelParent(nonFolder.Id, ChannelId));
+    }
+
+    [Fact]
+    public void GetParentChainIds_EpisodeProtectsSeasonSeriesAndChannel()
+    {
+        var (mgr, series, season, episode, _) = Build();
+        Assert.Equal(new[] { season.Id, series.Id, ChannelId }, mgr.GetParentChainIds(episode).ToArray());
+    }
+
+    [Fact]
+    public void GetParentChainIds_IsCycleSafeAndStopsAtMissingParent()
+    {
+        var (mgr, series, season, _, lib) = Build();
+        series.ParentId = season.Id;
+        Assert.Equal(new[] { series.Id, season.Id }, mgr.GetParentChainIds(new Episode { Id = Guid.NewGuid(), ParentId = series.Id }).ToArray());
+
+        var missing = Guid.NewGuid();
+        Assert.Equal(new[] { missing }, mgr.GetParentChainIds(new Episode { Id = Guid.NewGuid(), ParentId = missing }).ToArray());
+    }
+}
