+        /// <summary>
+        /// Determines whether an existing item's parent is still a live folder of
+        /// <paramref name="internalChannelId"/> and can therefore be preserved by a
+        /// non-authoritative (latest or per-item) channel refresh.
+        /// </summary>
+        /// <param name="parentId">The item's persisted parent id.</param>
+        /// <param name="internalChannelId">The internal channel id.</param>
+        /// <returns><c>true</c> if the parent can be kept.</returns>
+        internal bool IsValidChannelParent(Guid parentId, Guid internalChannelId)
+        {
+            if (parentId.IsEmpty())
+            {
+                return false;
+            }
+
+            if (parentId.Equals(internalChannelId))
+            {
+                return true;
+            }
+
+            return _libraryManager.GetItemById(parentId) is Folder parent
+                && internalChannelId.Equals(parent.ChannelId);
+        }
+
+        /// <summary>
+        /// Gets the ids of an item's parent chain (nearest first), bounded and
+        /// cycle-safe.
+        /// </summary>
+        /// <param name="item">The item.</param>
+        /// <returns>The parent ids.</returns>
+        internal IEnumerable<Guid> GetParentChainIds(BaseItem item)
+        {
+            var seen = new HashSet<Guid> { item.Id };
+            var parentId = item.ParentId;
+            for (var depth = 0; depth < 32 && !parentId.IsEmpty() && seen.Add(parentId); depth++)
+            {
+                yield return parentId;
+                var parent = _libraryManager.GetItemById(parentId);
+                if (parent is null)
+                {
+                    yield break;
+                }
+
+                parentId = parent.ParentId;
+            }
+        }
+
         internal IChannel GetChannelProvider(Channel channel)
         {
             ArgumentNullException.ThrowIfNull(channel);
